# Ignore binary build outputs
/bin/
/obj/

# Ignore user-specific files
*.user
*.suo

# Ignore Solution User Option files
*.sln.xo

# But keep these project-essential files
!README.md
!requirements.txt
!run.ps1

# Ignore NuGet packages (restored on build)
/packages/

# Ignore Visual Studio temporary files
*.user
*.vspscc
*.vssc

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore runtime configs if desired
# usersecrets.json