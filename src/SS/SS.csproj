<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>NU1903;AVLN3001</NoWarn>
    <Version>1.0.1</Version>
    <AssemblyName>SafeSale</AssemblyName>
    <Product>Safe-Sale</Product>
    <Authors>Safe-Sale Team</Authors>
    <Description>Sistema de Gestión de Supermercado</Description>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets\SS-ico.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models" />
    <AvaloniaResource Include="Assets\*" />
    <AvaloniaResource Include="Styles.axaml" />
    <None Include="www\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildProjectDirectory)/../../vendor/mysql/$(RuntimeIdentifier)/**/*"
          Link="vendor/mysql/$(RuntimeIdentifier)/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' != '' And Exists('$(MSBuildProjectDirectory)/../../vendor/mysql/$(RuntimeIdentifier)')" />
    <None Include="$(MSBuildProjectDirectory)/../../vendor/mysql/**/*"
          Link="vendor/mysql/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="'$(RuntimeIdentifier)' == '' And Exists('$(MSBuildProjectDirectory)/../../vendor/mysql')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="Velopack" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.osx.arm64" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.osx.x64" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.linux-x64" Version="4.10.0.20240717" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <CFBundleName>Safe-Sale</CFBundleName>
    <CFBundleDisplayName>Safe-Sale</CFBundleDisplayName>
    <CFBundleIdentifier>com.safesale.app</CFBundleIdentifier>
    <CFBundleVersion>1.0.1</CFBundleVersion>
    <CFBundleShortVersionString>1.0.1</CFBundleShortVersionString>
    <LSMinimumSystemVersion>12.0</LSMinimumSystemVersion>
    <NSHighResolutionCapable>true</NSHighResolutionCapable>
    <LSApplicationCategoryType>public.app-category.business</LSApplicationCategoryType>
    <InfoPlistFile>Platforms/macOS/Info.plist</InfoPlistFile>
    <AppInfoPlistFile>Platforms/macOS/Info.plist</AppInfoPlistFile>
    <CodeSignEntitlements>Platforms/macOS/Entitlements.plist</CodeSignEntitlements>
  </PropertyGroup>

</Project>