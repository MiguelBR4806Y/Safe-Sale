<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SS.ViewModels"
        x:Class="SS.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Safe-Sale - Iniciar Sesión"
        Width="400" Height="480"
        MinWidth="350" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#FAF3F7">

    <Border CornerRadius="16"
            Background="#FFFFFF"
            Margin="20"
            Padding="32,24"
            BorderBrush="#E8DAEF"
            BorderThickness="1"
            BoxShadow="0 4 16 0 #22000000">
        <StackPanel Spacing="0" VerticalAlignment="Center">

            <!-- Logo -->
            <TextBlock Text="SS"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="#4A148C"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Safe-Sale"
                       FontSize="14"
                       Foreground="#BB8FCE"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>
            <TextBlock Text="Sistema de Gestión de Supermercado"
                       FontSize="11"
                       Foreground="#7B1FA2"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,24"/>

            <!-- Usuario -->
            <TextBlock Text="Usuario"
                       FontSize="12"
                       Foreground="#4A148C"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBox Text="{Binding Username}"
                     PlaceholderText="Ingrese su usuario"
                     FontSize="14"
                     Padding="12,10"
                     CornerRadius="8"
                     BorderBrush="#E8DAEF"
                     BorderThickness="1"
                     Background="#FDFBFE"
                     Margin="0,0,0,16"/>

            <!-- Contraseña -->
            <TextBlock Text="Contraseña"
                       FontSize="12"
                       Foreground="#4A148C"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBox Text="{Binding Password}"
                     PasswordChar="*"
                     PlaceholderText="Ingrese su contraseña"
                     FontSize="14"
                     Padding="12,10"
                     CornerRadius="8"
                     BorderBrush="#E8DAEF"
                     BorderThickness="1"
                     Background="#FDFBFE"
                     Margin="0,0,0,8"/>

            <!-- Mensaje de error -->
            <Border Background="#22EF5350"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,0,0,16"
                    IsVisible="{Binding IsError}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#EF5350"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Botón Iniciar Sesión -->
            <Button Command="{Binding LoginCommand}"
                    Background="#4A148C"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Padding="0,14"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Cursor="Hand">
                <TextBlock Text="Iniciar Sesión"/>
            </Button>

            <!-- Credenciales por defecto -->
            <TextBlock Text="Admin por defecto: admin / admin123"
                       FontSize="10"
                       Foreground="#BB8FCE"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"
                       Opacity="0.7"/>

        </StackPanel>
    </Border>
</Window>
