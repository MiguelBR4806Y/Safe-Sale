<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SS.ViewModels"
        x:Class="SS.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Safe-Sale - Iniciar Sesión"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#FAF3F7">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="CaretBrush" Value="#4A148C"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#212121"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="12" Background="#FFFFFF" Margin="20">
        <StackPanel Spacing="20" Margin="30">
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="Safe-Sale"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#4A148C"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Sistema de Gestión de Supermercado"
                           FontSize="13"
                           Foreground="#9C27B0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <Border Height="1" Background="#E8DAEF"/>

            <!-- Form -->
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Usuario"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#6C3483"/>
                    <TextBox Text="{Binding Username}"
                             Height="36"
                             FontSize="13"
                             Padding="10,8"
                             CornerRadius="6"
                             BorderBrush="#E8DAEF"
                             BorderThickness="1"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Contraseña"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#6C3483"/>
                    <TextBox Text="{Binding Password}"
                             Height="36"
                             FontSize="13"
                             Padding="10,8"
                             CornerRadius="6"
                             BorderBrush="#E8DAEF"
                             BorderThickness="1"
                             PasswordChar="*">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                </StackPanel>

                <!-- Error -->
                <Border Background="#FFEBEE"
                        CornerRadius="6"
                        Padding="10,8"
                        IsVisible="{Binding IsError}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#EF5350"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- Login Button -->
                <Button Content="Iniciar Sesión"
                        Height="42"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#9C27B0"
                        CornerRadius="6"
                        Cursor="Hand"
                        Command="{Binding LoginCommand}"/>

                <TextBlock Text="Credenciales: admin / admin123"
                           FontSize="11"
                           Foreground="#BDBDBD"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>