<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SS.ViewModels"
        x:Class="SS.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Safe-Sale - Iniciar Sesión"
        Width="420" Height="540"
        MinWidth="380" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{StaticResource PrimaryHoverBrush}"
        KeyDown="Window_KeyDown">

    <!-- Fondo decorativo -->
    <Panel>
        <Border Background="{StaticResource PrimaryMediumBrush}" Opacity="0.08"
                CornerRadius="200" Width="400" Height="400"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="-100,-100,0,0"/>
        <Border Background="{StaticResource PrimaryMediumBrush}" Opacity="0.05"
                CornerRadius="200" Width="300" Height="300"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="0,0,-80,-80"/>

        <Border CornerRadius="20"
                Background="{StaticResource BackgroundCardBrush}"
                Margin="24"
                Padding="36,28"
                BoxShadow="0 8 32 0 #22000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
            <StackPanel Spacing="0" VerticalAlignment="Center">

                <!-- Logo -->
                <Border Background="{StaticResource PrimaryMediumBrush}" CornerRadius="16"
                        Width="64" Height="64"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                    <TextBlock Text="SS"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Safe-Sale"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryDarkBrush}"
                    HorizontalAlignment="Center"/>
                <TextBlock Text="Sistema de Gestión de Supermercado"
                    Classes="page-subtitle"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,28"/>

                <!-- Usuario -->
                <StackPanel Spacing="4" Margin="0,0,0,16">
                    <TextBlock Text="USUARIO"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               LetterSpacing="1"/>
                    <TextBox Name="UsernameBox"
                             Text="{Binding Username}"
                             PlaceholderText="Ingrese su usuario"
                             FontSize="14"
                             Padding="14,12"
                             CornerRadius="10"
                             BorderBrush="{StaticResource BorderLightBrush}"
                             BorderThickness="1.5"
                             Background="{StaticResource PrimaryBackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- Contraseña -->
                <StackPanel Spacing="4" Margin="0,0,0,12">
                    <TextBlock Text="CONTRASEÑA"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}"
                               LetterSpacing="1"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Name="PasswordBox"
                                 Text="{Binding Password}"
                                 PasswordChar="{Binding PasswordChar}"
                                 PlaceholderText="Ingrese su contraseña"
                                 FontSize="14"
                                 Padding="14,12"
                                 CornerRadius="10"
                                 BorderBrush="{StaticResource BorderLightBrush}"
                                 BorderThickness="1.5"
                                 Background="{StaticResource PrimaryBackgroundBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Button Name="TogglePasswordBtn"
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Margin="4,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Command="{Binding TogglePasswordCommand}"
                                ToolTip.Tip="Mostrar/ocultar contraseña">
                            <TextBlock Name="EyeIcon"
                                       Text="{Binding EyeIcon}"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Mensaje de actualización -->
                <Border Background="#224CAF50"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,16"
                        IsVisible="{Binding IsUpdateAvailable}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="&#x1F504;" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UpdateMessage}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Mensaje de error -->
                <Border Background="#22EF5350"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,16"
                        IsVisible="{Binding IsError}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="&#x26A0;" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Botón Iniciar Sesión -->
                <Button Command="{Binding LoginCommand}"
                        Classes="primary"
                        FontSize="14"
                        Padding="0,14"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Name="LoginBtnText"
                                   Text="Iniciar Sesión"
                                   VerticalAlignment="Center"/>
                        <ProgressBar Name="LoginSpinner"
                                     IsVisible="{Binding IsLoading}"
                                     Width="18" Height="18"
                                     IsIndeterminate="True"
                                     Foreground="White"
                                     Background="Transparent"
                                     VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Credenciales por defecto -->
                <Border Background="{StaticResource PrimarySurfaceLightBrush}"
                        CornerRadius="8"
                        Padding="12,8">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="Credenciales por defecto"
                                   Classes="caption"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="admin / admin123"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryMediumBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </Panel>
</Window>
