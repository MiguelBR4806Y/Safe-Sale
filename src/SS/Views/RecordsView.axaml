<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS.ViewModels"
             x:Class="SS.Views.RecordsView"
             x:DataType="vm:RecordsViewModel">

    <Border Background="{StaticResource BackgroundAppBrush}" CornerRadius="8">
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">

                <!-- Header -->
                <StackPanel Spacing="2">
                    <TextBlock Text="REGISTROS" Classes="page-title"/>
                    <TextBlock Text="Historial de ventas y transacciones" Classes="page-subtitle"/>
                </StackPanel>

                <!-- Filtros -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x1F50D;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Filtros de búsqueda" Classes="section-title" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Classes="separator"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Desde:" Classes="caption"/>
                                <DatePicker Width="150" SelectedDate="{Binding FilterFrom}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Hasta:" Classes="caption"/>
                                <DatePicker Width="150" SelectedDate="{Binding FilterTo}"/>
                            </StackPanel>
                            <Button Content="Filtrar"
                                    Classes="primary"
                                    Command="{Binding FilterCommand}"
                                    VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Estadísticas -->
                <Grid ColumnDefinitions="*,*" Margin="0,2">
                    <Border Grid.Column="0" Classes="card" Margin="0,0,4,0">
                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <TextBlock Text="&#x1F4B0;" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Total Ventas" Classes="card-label" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalSales, StringFormat='{}${0:F2}'}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryMediumBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Margin="4,0,0,0">
                        <StackPanel HorizontalAlignment="Center" Spacing="6">
                            <TextBlock Text="&#x1F4CA;" FontSize="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Transacciones" Classes="card-label" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalTransactions}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Tabla de registros -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#x1F4DD;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Detalle de ventas" Classes="section-title" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalTransactions, StringFormat='({0} registros)'}"
                                       Classes="caption" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <Border Classes="separator"/>

                        <ListBox ItemsSource="{Binding Sales}" Height="280"
                                 SelectedItem="{Binding SelectedSale, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10"
                                            Background="{StaticResource PrimaryBackgroundBrush}"
                                            CornerRadius="8"
                                            Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Border Grid.Column="0"
                                                    Background="{StaticResource PrimarySurfaceBrush}"
                                                    CornerRadius="8"
                                                    Width="34" Height="34"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="&#x1F4B3;"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Id, StringFormat='Venta #{0}'}"
                                                           Classes="card-value"/>
                                                <TextBlock Text="{Binding CreatedAt}" Classes="caption"/>
                                                <TextBlock Text="{Binding SummaryLabel}" Classes="caption"/>
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Background="{StaticResource PrimaryHoverBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="Venta"
                                                           FontSize="10"
                                                           FontWeight="Medium"
                                                           Foreground="{StaticResource PrimaryMediumBrush}"/>
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Total, StringFormat='{}${0:F2}'}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryMediumBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Detalle de la venta seleccionada -->
                <Border Classes="card" IsVisible="{Binding HasSelectedSale}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="&#x1F9FE;" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Detalle de la venta" Classes="section-title"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedSaleTitle}" Classes="caption"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedCashierLabel}"
                                           Classes="caption"/>
                                <TextBlock Text="{Binding SelectedSale.PaymentMethod}"
                                           Classes="caption"/>
                            </StackPanel>
                        </Grid>

                        <Border Classes="separator"/>

                        <Grid ColumnDefinitions="*,70,90,90" Margin="12,0,12,0">
                            <TextBlock Grid.Column="0" Text="PRODUCTO" Classes="caption"
                                       FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="CANT." Classes="caption"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="P. UNIT." Classes="caption"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="SUBTOTAL" Classes="caption"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SelectedSaleItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8"
                                            Background="{StaticResource PrimaryBackgroundBrush}"
                                            CornerRadius="8" Margin="0,2">
                                        <Grid ColumnDefinitions="*,70,90,90">
                                            <SelectableTextBlock Grid.Column="0"
                                                                 Text="{Binding ProductName}"
                                                                 FontSize="12" FontWeight="SemiBold"
                                                                 Foreground="{StaticResource PrimaryDarkBrush}"
                                                                 TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity}"
                                                       FontSize="12" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding PriceSold, StringFormat='{}${0:F2}'}"
                                                       FontSize="12" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Subtotal, StringFormat='{}${0:F2}'}"
                                                       FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource PrimaryMediumBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{StaticResource PrimaryBackgroundBrush}"
                                CornerRadius="8" Padding="12,10">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Subtotal" Classes="caption"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedSubtotal, StringFormat='{}${0:F2}'}"
                                               FontSize="12" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding SelectedIvaLabel}" Classes="caption"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedIvaAmount, StringFormat='{}${0:F2}'}"
                                               FontSize="12" FontWeight="SemiBold"/>
                                </Grid>
                                <Border Classes="separator"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="TOTAL" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedTotal, StringFormat='{}${0:F2}'}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryMediumBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
