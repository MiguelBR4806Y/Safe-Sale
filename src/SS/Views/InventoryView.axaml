<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS.ViewModels"
             xmlns:conv="using:SS.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="mc"
             x:Class="SS.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">

    <UserControl.Resources>
        <conv:BoolToStringConverter x:Key="MobileTextConverter"
                                     TrueValue="Desconectar"
                                     FalseValue="Escanear con Móvil"/>
        <conv:BoolToColorConverter x:Key="MobileColorConverter"
                                     TrueColor="#EF5350"
                                     FalseColor="#7B1FA2"/>
        <conv:BoolToStringConverter x:Key="CameraTextConverter"
                                     TrueValue="Cerrar Cámara"
                                     FalseValue="Iniciar Cámara"/>
        <conv:BoolToColorConverter x:Key="CameraColorConverter"
                                     TrueColor="#EF5350"
                                     FalseColor="#4CAF50"/>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundAppBrush}" CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="16">

            <!-- Row 0: Título + Búsqueda -->
            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                <TextBlock Text="INVENTARIO" Classes="page-title" HorizontalAlignment="Center"/>
                <Border Classes="card">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="250" Height="32"
                                 PlaceholderText="Buscar producto por nombre o código..."
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="Buscar" Classes="secondary"
                                Command="{Binding SearchCommand}"/>
                        <Button Content="Refrescar" Classes="ghost"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Row 1: Estadísticas + Botones escáner -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <!-- Stats compactos -->
                <Border Grid.Column="0" Classes="card" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Total:" Classes="card-label" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalProducts}" Classes="card-value" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Stock bajo:" Classes="card-label" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LowStock}" Classes="card-value"
                                       Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Categorías:" Classes="card-label" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CategoriesCount}" Classes="card-value" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Valor:" Classes="card-label" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ValueTotal, StringFormat='{}${0:F2}'}" Classes="card-value" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Botones de escáner -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding ToggleCameraCommand}"
                            Classes="secondary"
                            Content="{Binding IsCameraActive, Converter={StaticResource CameraTextConverter}}"
                            Background="{Binding IsCameraActive, Converter={StaticResource CameraColorConverter}}"
                            Foreground="White"
                            Padding="14,10"
                            MinWidth="130"/>
                    <Button Command="{Binding ToggleMobileScannerCommand}"
                            Classes="secondary"
                            Content="{Binding IsMobileScannerActive, Converter={StaticResource MobileTextConverter}}"
                            Background="{Binding IsMobileScannerActive, Converter={StaticResource MobileColorConverter}}"
                            Foreground="White"
                            Padding="14,10"
                            MinWidth="140"/>
                </StackPanel>
            </Grid>

            <!-- Row 2: Cámara PC + QR inline -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <!-- Cámara PC -->
                <Border Grid.Column="0" Classes="card" Margin="0,0,6,0"
                        IsVisible="{Binding IsCameraActive}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Escáner de Cámara" Classes="section-title"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                            <TextBlock Text="Cámara:" Classes="card-label" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding AvailableCameras}"
                                      SelectedIndex="{Binding SelectedCameraIndex}"
                                      Width="200" Height="28"/>
                        </StackPanel>
                        <Border CornerRadius="6" Padding="6"
                                Background="{StaticResource PrimarySurfaceLightBrush}"
                                IsVisible="{Binding ScanFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ScanFeedback}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding ScanFeedbackColor}"/>
                        </Border>
                        <Grid Height="140">
                            <Image Source="{Binding CameraPreview}" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border BorderBrush="{StaticResource SuccessBrush}" BorderThickness="2" CornerRadius="8" Margin="20,15"
                                    Background="#11000000"/>
                            <TextBlock Text="Coloque el código dentro del marco"
                                       FontSize="10" Foreground="White" Background="#AA000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Margin="0,0,0,8" Padding="8,3"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- QR inline -->
                <Border Grid.Column="1" Classes="card-flat"
                        IsVisible="{Binding IsMobileScannerActive}">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Image Source="{Binding MobileQrBitmap}" Width="70" Height="70" Stretch="Uniform"/>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Móvil" Classes="card-label"/>
                            <TextBlock Text="{Binding MobileUrl}" FontSize="8"
                                       Foreground="{StaticResource PrimaryLightBrush}"
                                       TextWrapping="Wrap" MaxWidth="120"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3: Tabla de productos -->
            <Border Grid.Row="3" Classes="card" Margin="0,0,0,8">
                <ListBox ItemsSource="{Binding Products}"
                         SelectedItem="{Binding SelectedProduct}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6"
                                    Background="{StaticResource PrimaryBackgroundBrush}"
                                    CornerRadius="6"
                                    Margin="0,2">
                                <Grid ColumnDefinitions="40,150,120,80,50,50">
                                    <TextBlock Grid.Column="0" Text="{Binding Id}"
                                               Classes="caption" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Classes="card-value" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Barcode}"
                                               Classes="caption" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Price, StringFormat='{}${0:F2}'}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryMediumBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Stock}"
                                               Classes="card-value" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding MinStock}"
                                               Classes="card-label"
                                               Foreground="{StaticResource DangerBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Row 4: Botones de acción -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button Content="Agregar" Classes="secondary"
                        Command="{Binding AddProductCommand}"/>
                <Button Content="Editar" Classes="secondary"
                        Command="{Binding EditProductCommand}"/>
                <Button Content="Eliminar" Classes="danger"
                        Command="{Binding DeleteProductCommand}"/>
                <Button Content="Agregar al Carrito" Classes="success"
                        Command="{Binding AddToCartCommand}"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
