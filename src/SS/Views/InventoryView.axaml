<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="mc"
             x:Class="SS.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">

    <Border Background="#FAF3F7" CornerRadius="8">
        <ScrollViewer>
            <StackPanel Margin="20" Spacing="15">

                <TextBlock Text="INVENTARIO"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="#4A148C"
                    Margin="0,0,0,15"
                    HorizontalAlignment="Center"/>

                <!-- Barra de busqueda -->
                <Border Background="#FFFFFF" CornerRadius="4" Margin="0,0,0,10" Padding="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Buscar"
                            FontSize="12"
                            Foreground="#6C3483"
                            VerticalAlignment="Center"
                            Margin="5"/>
                        <TextBox Width="300"
                            Height="30"
                            FontSize="12"
                            PlaceholderText="Buscar producto por Nombre o Código..."
                            Text="{Binding SearchText, Mode=TwoWay}"
                            VerticalContentAlignment="Center"/>
                        <Button Content="Buscar"
                            Width="70"
                            Height="30"
                            Background="#BB8FCE"
                            Foreground="White"
                            FontSize="12"
                            Command="{Binding SearchCommand}"
                            Cursor="Hand"
                            VerticalContentAlignment="Center"/>
                        <Button Content="Refrescar"
                            Width="80"
                            Height="30"
                            Background="#6C3483"
                            Foreground="White"
                            FontSize="12"
                            Command="{Binding RefreshCommand}"
                            Cursor="Hand"
                            VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Estadisticas rapidas -->
                <UniformGrid Columns="4" Margin="0,10,0,10">
                    <Border Background="#E8DAEF" CornerRadius="6" Padding="10" Margin="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total"
                                FontSize="12"
                                Foreground="#4A148C"
                                HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalProducts}"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#7B1FA2"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#E8DAEF" CornerRadius="6" Padding="10" Margin="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Stock Bajo"
                                FontSize="12"
                                Foreground="#4A148C"
                                HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding LowStock}"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#EF5350"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#E8DAEF" CornerRadius="6" Padding="10" Margin="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Categorias"
                                FontSize="12"
                                Foreground="#4A148C"
                                HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CategoriesCount}"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#7B1FA2"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#E8DAEF" CornerRadius="6" Padding="10" Margin="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Valor Total"
                                FontSize="12"
                                Foreground="#4A148C"
                                HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ValueTotal, StringFormat=${0:F2}}"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#7B1FA2"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Tabla de Productos -->
                <Border Background="#FFFFFF" CornerRadius="8" Margin="0,10" Padding="5">
                    <ListBox ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct}"
                             Height="300">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3">
                                    <TextBlock Text="{Binding Id}"
                                               Width="40"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center"
                                               Width="150"/>
                                    <TextBlock Text="{Binding Barcode}"
                                               FontSize="12"
                                               Foreground="#6C3483"
                                               VerticalAlignment="Center"
                                               Width="130"/>
                                    <TextBlock Text="{Binding Price, StringFormat=${0:F2}}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Width="100"/>
                                    <TextBlock Text="{Binding Stock}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Width="60"/>
                                    <TextBlock Text="{Binding MinStock}"
                                               FontSize="12"
                                               Foreground="#EF5350"
                                               VerticalAlignment="Center"
                                               Width="60"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Acciones -->
                <StackPanel Orientation="Horizontal" Margin="0,10" HorizontalAlignment="Center" Spacing="10">
                    <Button Content="Agregar"
                            Background="#BB8FCE"
                            Foreground="White"
                            FontSize="12"
                            Command="{Binding AddProductCommand}"
                            Cursor="Hand"
                            Padding="12,8"/>

                    <Button Content="Editar"
                            Background="#BB8FCE"
                            Foreground="White"
                            FontSize="12"
                            Command="{Binding EditProductCommand}"
                            Cursor="Hand"
                            Padding="12,8"/>

                    <Button Content="Eliminar"
                            Background="#EF5350"
                            Foreground="White"
                            FontSize="12"
                            Command="{Binding DeleteProductCommand}"
                            Cursor="Hand"
                            Padding="12,8"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
