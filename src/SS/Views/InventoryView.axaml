<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS.ViewModels"
             xmlns:conv="using:SS.Converters"
             x:Class="SS.Views.InventoryView"
             x:DataType="vm:InventoryViewModel">

    <UserControl.Resources>
        <conv:BoolToStringConverter x:Key="MobileTextConverter"
                                     TrueValue="Desconectar"
                                     FalseValue="Escanear con Movil"/>
        <conv:BoolToColorConverter x:Key="MobileColorConverter"
                                     TrueColor="#EF5350"
                                     FalseColor="#7B1FA2"/>
        <conv:BoolToStringConverter x:Key="CameraTextConverter"
                                     TrueValue="Cerrar Camara"
                                     FalseValue="Iniciar Camara"/>
        <conv:BoolToColorConverter x:Key="CameraColorConverter"
                                     TrueColor="#EF5350"
                                     FalseColor="#4CAF50"/>
    </UserControl.Resources>

    <Border Background="#FAF3F7" CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">

            <!-- Row 0: Titulo + Busqueda -->
            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                <TextBlock Text="INVENTARIO" FontSize="24" FontWeight="Bold"
                           Foreground="#4A148C" HorizontalAlignment="Center"/>
                <Border Background="#FFFFFF" CornerRadius="10" Padding="16" BoxShadow="0 2 8 0 #11000000">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="250" Height="32" FontSize="12"
                                 PlaceholderText="Buscar producto por nombre o código..."
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="Buscar" Classes="secondary"
                                Command="{Binding SearchCommand}"/>
                        <Button Content="Refrescar" Classes="ghost"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Row 1: Metricas globales + Botones escaner -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <!-- Metricas globales: 5 KPIs -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="14" Margin="0,0,6,0"
                        BoxShadow="0 2 8 0 #11000000">
                    <Grid ColumnDefinitions="*,*,*,*,*">
                        <!-- Productos -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="&#x1F4E6;" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Productos" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9C8EBF" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding GlobalMetrics.ProductCount}" FontSize="22"
                                       FontWeight="Bold" Foreground="#4A148C" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- Unidades en Stock -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="&#x1F4E8;" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Unidades en Stock" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9C8EBF" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding GlobalMetrics.TotalUnits}" FontSize="22"
                                       FontWeight="Bold" Foreground="#7B1FA2" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- Stock Bajo -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="&#x26A0;" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Stock Bajo" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9C8EBF" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding GlobalMetrics.LowStockCount}" FontSize="22"
                                       FontWeight="Bold" Foreground="#EF5350" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- Categorias -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="&#x1F4C1;" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Categorias" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9C8EBF" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CategoryGroups.Count}" FontSize="22"
                                       FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- Valor Estimado -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="&#x1F4B0;" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Valor Estimado" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9C8EBF" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding GlobalMetrics.EstimatedValue, StringFormat=${0:F2}}"
                                       FontSize="20" FontWeight="Bold" Foreground="#7B1FA2"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- Botones de escaner -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Cámara:" FontSize="11" Foreground="#4A148C"
                                   VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding AvailableCameras}"
                                  SelectedIndex="{Binding SelectedCameraIndex}"
                                  MinWidth="180" Height="28" FontSize="11"/>
                    </StackPanel>
                    <Button Command="{Binding ToggleCameraCommand}" Classes="secondary"
                            Content="{Binding IsCameraActive, Converter={StaticResource CameraTextConverter}}"
                            Background="{Binding IsCameraActive, Converter={StaticResource CameraColorConverter}}"/>
                    <Button Command="{Binding ToggleMobileScannerCommand}" Classes="primary"
                            Content="{Binding IsMobileScannerActive, Converter={StaticResource MobileTextConverter}}"/>
                </StackPanel>
            </Grid>

            <!-- Row 2: Camara PC + QR inline -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Padding="12" Margin="0,0,6,0"
                        BoxShadow="0 2 8 0 #11000000"
                        IsVisible="{Binding IsCameraActive}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Escaner de Camara" FontSize="12" Foreground="#4A148C" FontWeight="SemiBold"/>
                        <Border CornerRadius="6" Padding="6" Background="#F5F5F5"
                                IsVisible="{Binding ScanFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ScanFeedback}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{Binding ScanFeedbackColor}"/>
                        </Border>
                        <Grid Height="140">
                            <Image Source="{Binding CameraPreview}" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border BorderBrush="#4CAF50" BorderThickness="2" CornerRadius="6" Margin="20,15"
                                    Background="#11000000"/>
                            <TextBlock Text="Coloque el codigo dentro del marco"
                                       FontSize="9" Foreground="White" Background="#AA000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                       Margin="0,0,0,6" Padding="6,2"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#F5F0FA" CornerRadius="10" Padding="8"
                        IsVisible="{Binding IsMobileScannerActive}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Image Source="{Binding MobileQrBitmap}" Width="60" Height="60" Stretch="Uniform"/>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Movil" FontSize="10" Foreground="#6C3483"/>
                            <TextBlock Text="{Binding MobileUrl}" FontSize="7" Foreground="#BB8FCE"
                                       TextWrapping="Wrap" MaxWidth="120"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3: Categorias con productos -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                <StackPanel Spacing="24">
                    <ItemsControl ItemsSource="{Binding CategoryGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryGroup}">
                                <Border Background="#FFFFFF" CornerRadius="10" Padding="14"
                                        BoxShadow="0 4 14 0 #1A000000" Margin="4,4,4,0">
                                    <StackPanel Spacing="8">
                                        <!-- Header de categoria -->
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                                              Cursor="Hand"
                                              PointerPressed="OnCategoryHeaderPressed">
                                            <!-- Icono + Nombre -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <Border Width="32" Height="32" CornerRadius="8"
                                                        Background="{Binding Category.Color}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category.Icon}" FontSize="16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Category.Name}" FontSize="14"
                                                           FontWeight="Bold" Foreground="#4A148C"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Metricas de categoria -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="Prod:" FontSize="10" Foreground="#9C8EBF"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Metrics.ProductCount}" FontSize="13"
                                                               FontWeight="Bold" Foreground="#4A148C"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="Stock:" FontSize="10" Foreground="#9C8EBF"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Metrics.TotalUnits}" FontSize="13"
                                                               FontWeight="Bold" Foreground="#7B1FA2"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="Bajo:" FontSize="10" Foreground="#9C8EBF"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Metrics.LowStockCount}" FontSize="13"
                                                               FontWeight="Bold" Foreground="#EF5350"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="Valor:" FontSize="10" Foreground="#9C8EBF"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Metrics.EstimatedValue, StringFormat=${0:F2}}"
                                                               FontSize="13" FontWeight="Bold" Foreground="#7B1FA2"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Chevron -->
                                            <TextBlock Grid.Column="6" Text="{Binding ChevronIcon}" FontSize="10"
                                                       Foreground="#9C8EBF" VerticalAlignment="Center"
                                                       Margin="8,0,4,0"/>
                                        </Grid>

                                        <Border Height="1" Background="#F0EAF5"/>

                                        <!-- Contenido colapsable -->
                                        <StackPanel IsVisible="{Binding IsExpanded}" Spacing="0">
                                            <!-- Encabezados de columna -->
                                            <Grid ColumnDefinitions="Auto,*,120,80,60" Margin="10,4">
                                                <!-- Col 0: espacio reservado para checkbox -->
                                                <TextBlock Grid.Column="1" Text="Producto" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="#9C8EBF"/>
                                                <TextBlock Grid.Column="2" Text="Código" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="#9C8EBF"/>
                                                <TextBlock Grid.Column="3" Text="Precio" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="#9C8EBF"/>
                                                <TextBlock Grid.Column="4" Text="Stock" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="#9C8EBF"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Productos de esta categoria -->
                                            <ListBox ItemsSource="{Binding Products}"
                                                     Background="Transparent" BorderThickness="0"
                                                     SelectedItem="{Binding $parent[ItemsControl].((vm:InventoryViewModel)DataContext).SelectedProduct, Mode=TwoWay}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="10,7" BorderBrush="#E0E0E0"
                                                                BorderThickness="0,0,0,1" Background="#FFFFFF">
                                                            <Grid ColumnDefinitions="Auto,*,120,80,60">
                                                                <!-- Checkbox de seleccion (solo visible en modo seleccion) -->
                                                                <CheckBox Grid.Column="0"
                                                                          IsVisible="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).IsSelectionModeActive}"
                                                                          Command="{Binding $parent[UserControl].((vm:InventoryViewModel)DataContext).ToggleProductSelectionCommand}"
                                                                          CommandParameter="{Binding}"
                                                                          Margin="0,0,8,0"
                                                                          VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                                           Foreground="#2D1B4E" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Barcode}"
                                                                           FontSize="11" Foreground="#757575"
                                                                           FontStyle="Italic" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3"
                                                                           Text="{Binding Price, StringFormat=${0:F2}}"
                                                                           FontSize="12" FontWeight="Bold"
                                                                           Foreground="#7B1FA2" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding Stock}"
                                                                           FontSize="12" FontWeight="Bold"
                                                                           Foreground="#4A148C" VerticalAlignment="Center"
                                                                           HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <!-- Estado vacio cuando no hay productos en esta categoria -->
                                            <Border IsVisible="{Binding IsEmpty}"
                                                    Padding="20,14" HorizontalAlignment="Center">
                                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="No hay productos en esta categoría"
                                                               FontSize="12" Foreground="#9E9E9E"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Agregue productos desde el escáner o el botón Agregar"
                                                               FontSize="10" Foreground="#BDBDBD"
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Mensaje si no hay categorias (no deberia ocurrir) -->
                    <Border IsVisible="{Binding IsCategoryGroupsEmpty}" Padding="40" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="No hay categorías configuradas"
                                       FontSize="14" Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                            <TextBlock Text="Las categorías se cargan automáticamente al iniciar"
                                       FontSize="11" Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Row 4: Botones de accion -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <!-- Columna izquierda: agregar / editar -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
                    <Button Content="Agregar" Classes="primary"
                            Command="{Binding AddProductCommand}"/>
                    <Button Content="Editar" Classes="secondary"
                            Command="{Binding EditProductCommand}"/>
                </StackPanel>
                <!-- Columna derecha: eliminar / carrito / vaciar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{Binding DeleteButtonText}"
                            Classes="danger"
                            IsEnabled="{Binding IsDeleteEnabled}"
                            Command="{Binding DeleteProductCommand}"/>
                    <Button Content="{Binding AddToCartButtonText}"
                            Classes="success"
                            IsEnabled="{Binding IsCartEnabled}"
                            Command="{Binding AddToCartCommand}"/>
                    <Button Content="Vaciar Inventario" Classes="danger"
                            IsEnabled="{Binding HasProducts}"
                            Command="{Binding ClearInventoryCommand}"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
