<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="mc"
             x:Class="SS.Views.InventoryView">

    <UserControl.DataContext>
        <vm:InventoryViewModel/>
    </UserControl.DataContext>

    <Design.DataContext>
        <vm:InventoryViewModel/>
    </Design.DataContext>

    <Border Background="#FAF3F7" CornerRadius="8">
        <StackPanel Margin="20" Spacing="15">
            
            <!-- Título -->
            <TextBlock Text="INVENTARIO"
                FontSize="24"
                FontWeight="Bold"
                Foreground="#4A148C"
                Margin="0,0,0,15"
                HorizontalAlignment="Center"/>

            <!-- Barra de búsqueda -->
            <Border Background="#FFFFFF" CornerRadius="4" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <TextBlock Text="🔍 Buscar"
                        FontSize="12"
                        Foreground="#6C3483"
                        VerticalAlignment="Center"
                        Margin="5"/>
                    <TextBox x:Name="SearchTextBox"
                        Width="300"
                        Height="30"
                        FontSize="12"
                        Placeholder="Buscar producto por nombre o código..."
                        Text="{Binding SearchText, Mode=TwoWay}"
                        VerticalContentAlignment="Center"/>
                    <Button Content="🔍"
                        Width="35"
                        Height="30"
                        Background="#BB8FCE"
                        Foreground="White"
                        FontSize="12"
                        Command="{Binding SearchCommand}"
                        Cursor="Hand"
                        VerticalContentAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Estadísticas rápidas -->
            <UniformGrid Columns="4" Margin="0,10,0,10">
                <Border Background="#E8DAEF" CornerRadius="6" Padding="10">
                    <TextBlock Text="Total"
                        FontSize="14"
                        Foreground="#4A148C"
                        HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalProductsTxt"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#7B1FA2"
                        HorizontalAlignment="Center"/>
                </Border>
                <Border Background="#E8DAEF" CornerRadius="6" Padding="10">
                    <TextBlock Text="Stock Bajo"
                        FontSize="14"
                        Foreground="#4A148C"
                        HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LowStockTxt"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#EF5350"
                        HorizontalAlignment="Center"/>
                </Border>
                <Border Background="#E8DAEF" CornerRadius="6" Padding="10">
                    <TextBlock Text="Categorías"
                        FontSize="14"
                        Foreground="#4A148C"
                        HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CategoriesTxt"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#7B1FA2"
                        HorizontalAlignment="Center"/>
                </Border>
                <Border Background="#E8DAEF" CornerRadius="6" Padding="10">
                    <TextBlock Text="Valor Total"
                        FontSize="14"
                        Foreground="#4A148C"
                        HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ValueTotalTxt"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#7B1FA2"
                        HorizontalAlignment="Center"/>
                </Border>
            </UniformGrid>

            <!-- Tabla de productos -->
            <Border Background="#FFFFFF" CornerRadius="8" Margin="0,10">
                <ListView x:Name="ProductsListView"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          Height="300"
                          Margin="10">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="10">
                                <TextBlock Text="{Binding Id}" Width="40" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Barcode}" FontSize="12" Foreground="#6C3483" VerticalAlignment="Center" Width="120"/>
                                <TextBlock Text="{Binding Price, StringFormat=C}" FontSize="14" VerticalAlignment="Center" Width="100"/>
                                <TextBlock Text="{Binding Stock}" FontSize="14" VerticalAlignment="Center" Width="60"/>
                                <TextBlock Text="{Binding MinStock}" FontSize="12" Foreground="#EF5350" VerticalAlignment="Center" Width="60"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Acciones -->
            <StackPanel Orientation="Horizontal" Margin="0,10" HorizontalAlignment="Center" Spacing="10">
                <Button Content="➕ Agregar Producto"
                        Background="#BB8FCE"
                        Foreground="White"
                        FontSize="12"
                        Command="{Binding AddProductCommand}"
                        Cursor="Hand"
                        Width="130"/>

                <Button Content="✏️ Editar"
                        Background="#BB8FCE"
                        Foreground="White"
                        FontSize="12"
                        Command="{Binding EditProductCommand}"
                        Cursor="Hand"
                        Width="100"/>

                <Button Content="🗑️ Eliminar"
                        Background="#EF5350"
                        Foreground="White"
                        FontSize="12"
                        Command="{Binding DeleteProductCommand}"
                        Cursor="Hand"
                        Width="100"/>

                <Button Content="📥 Cargar por Barra"
                        Background="#BB8FCE"
                        Foreground="White"
                        FontSize="12"
                        Command="{Binding LoadByBarcodeCommand}"
                        Cursor="Hand"
                        Width="140"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>