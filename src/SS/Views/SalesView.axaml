<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS.ViewModels"
             xmlns:conv="using:SS.Converters"
             x:Class="SS.Views.SalesView"
             x:DataType="vm:SalesViewModel">

    <UserControl.Resources>
        <conv:BoolToStringConverter x:Key="CameraTextConverter"
                                     TrueValue="Cerrar Cámara"
                                     FalseValue="Iniciar Cámara"/>
        <conv:BoolToColorConverter x:Key="CameraColorConverter"
                                     TrueColor="#EF5350"
                                     FalseColor="#4CAF50"/>
        <conv:BoolToStringConverter x:Key="MobileTextConverter"
                                     TrueValue="Cerrar Móvil"
                                     FalseValue="Escanear Móvil"/>
        <conv:BoolToColorConverter x:Key="MobileColorConverter"
                                     TrueColor="#EF5350"
                                     FalseColor="#7B1FA2"/>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundAppBrush}" CornerRadius="8">
        <Grid ColumnDefinitions="*,350" Margin="16" RowDefinitions="Auto,*">
            <!-- Panel izquierdo: Carrito -->
            <StackPanel Grid.Column="0" Grid.Row="0" Spacing="10">
                <!-- Cámara + Escáner -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Escáner de Cámara" Classes="section-title" VerticalAlignment="Center"/>
                            <Button Command="{Binding ToggleCameraCommand}"
                                    Classes="secondary"
                                    Content="{Binding IsCameraActive, Converter={StaticResource CameraTextConverter}}"
                                    Background="{Binding IsCameraActive, Converter={StaticResource CameraColorConverter}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Cámara:" Classes="card-label" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding AvailableCameras}"
                                      SelectedIndex="{Binding SelectedCameraIndex}"
                                      Width="200" Height="28"/>
                        </StackPanel>

                        <!-- Feedback del escáner -->
                        <Border CornerRadius="6"
                                Padding="10,8"
                                Background="{StaticResource PrimarySurfaceLightBrush}"
                                IsVisible="{Binding ScanFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ScanFeedback}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding ScanFeedbackColor}"/>
                        </Border>

                        <!-- Vista previa de cámara con marco de escaneo -->
                        <Grid Height="200" IsVisible="{Binding IsCameraActive}">
                            <!-- Video de la cámara -->
                            <Image Source="{Binding CameraPreview}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                            <!-- Marco de escaneo (overlay) -->
                            <Border BorderBrush="{StaticResource SuccessBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Margin="30,30"
                                    Background="#11000000"/>

                            <!-- Esquinas destacadas del marco -->
                            <Canvas>
                                <Border Canvas.Left="30" Canvas.Top="30" Width="20" Height="20"
                                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="3,0,0,3" CornerRadius="6,0,0,0"/>
                                <Border Canvas.Right="30" Canvas.Top="30" Width="20" Height="20"
                                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="0,3,3,0" CornerRadius="0,6,0,0"/>
                                <Border Canvas.Left="30" Canvas.Bottom="30" Width="20" Height="20"
                                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="3,0,0,3" CornerRadius="0,0,0,6"/>
                                <Border Canvas.Right="30" Canvas.Bottom="30" Width="20" Height="20"
                                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="0,3,3,0" CornerRadius="0,0,6,0"/>
                            </Canvas>

                            <!-- Texto indicativo -->
                            <TextBlock Text="Coloque el código dentro del marco"
                                       FontSize="11"
                                       Foreground="White"
                                       Background="#AA000000"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,10"
                                       Padding="10,4"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Escáner Móvil -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Escáner Móvil" Classes="section-title" VerticalAlignment="Center"/>
                            <Button Command="{Binding ToggleMobileScannerCommand}"
                                    Classes="secondary"
                                    Content="{Binding IsMobileScannerActive, Converter={StaticResource MobileTextConverter}}"
                                    Background="{Binding IsMobileScannerActive, Converter={StaticResource MobileColorConverter}}"/>
                        </StackPanel>
                        <Border CornerRadius="6" Padding="8,6"
                                Background="{StaticResource PrimarySurfaceLightBrush}"
                                IsVisible="{Binding MobileScanFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding MobileScanFeedback}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding MobileScanFeedbackColor}"/>
                        </Border>
                        <Border Classes="card-flat"
                                IsVisible="{Binding IsMobileScannerActive}">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <Image Source="{Binding MobileQrBitmap}" Width="70" Height="70" Stretch="Uniform"/>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Escanea desde tu teléfono" Classes="caption"/>
                                    <TextBlock Text="Solo productos existentes" Classes="caption"
                                               Foreground="{StaticResource PrimaryLightBrush}"/>
                                    <TextBlock Text="{Binding MobileUrl}" FontSize="8"
                                               Foreground="{StaticResource PrimaryLightBrush}"
                                               TextWrapping="Wrap" MaxWidth="150"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Barra de búsqueda por código de barras -->
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="O ingrese código manualmente:" Classes="section-title"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="220"
                                     PlaceholderText="Escribir o escanear..."
                                     Text="{Binding BarcodeInput, Mode=TwoWay}"
                                     VerticalContentAlignment="Center">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter"
                                                Command="{Binding AddByBarcodeCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Content="Buscar" Classes="secondary"
                                    Command="{Binding AddByBarcodeCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Classes="body"/>
                    </StackPanel>
                </Border>

                <!-- Carrito -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Carrito de Compras" Classes="section-title"/>

                        <ListBox ItemsSource="{Binding CartItems}"
                                 Height="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8"
                                            Background="{StaticResource PrimaryBackgroundBrush}"
                                            CornerRadius="8"
                                            Margin="0,2">
                                        <Grid ColumnDefinitions="150,Auto,80,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding ProductName}"
                                                       Classes="card-value" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Spacing="6">
                                                <Button Content="-"
                                                        Classes="icon"
                                                        Background="{StaticResource PrimarySurfaceBrush}"
                                                        Foreground="{StaticResource PrimaryDarkBrush}"
                                                        Command="{Binding $parent[ListBox].((vm:SalesViewModel)DataContext).DecreaseQtyCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding Quantity}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Width="30"
                                                           HorizontalAlignment="Center"/>
                                                <Button Content="+"
                                                        Classes="icon"
                                                        Background="{StaticResource PrimarySurfaceBrush}"
                                                        Foreground="{StaticResource PrimaryDarkBrush}"
                                                        Command="{Binding $parent[ListBox].((vm:SalesViewModel)DataContext).IncreaseQtyCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Subtotal, StringFormat='{}${0:F2}'}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryMediumBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"/>
                                            <Button Grid.Column="3"
                                                    Content="X"
                                                    Classes="icon"
                                                    Background="{StaticResource DangerBrush}"
                                                    Foreground="White"
                                                    Command="{Binding $parent[ListBox].((vm:SalesViewModel)DataContext).RemoveFromCartCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Panel derecho: Resumen y cobro -->
            <Border Grid.Column="1"
                    Grid.Row="0"
                    Classes="card"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top">
                <StackPanel Spacing="16">
                    <TextBlock Text="Resumen de Venta" Classes="section-title"/>

                    <Border Classes="separator"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Items:" Classes="body" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CartCount}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryMediumBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total:"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CartTotal, StringFormat='{}${0:F2}'}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryMediumBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Classes="separator"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Método de pago:" Classes="section-title"/>
                        <ComboBox ItemsSource="{Binding PaymentMethods}"
                                  SelectedItem="{Binding SelectedPaymentMethod}"/>
                    </StackPanel>

                    <Button Content="COBRAR"
                            Classes="primary"
                            FontSize="16"
                            FontWeight="Bold"
                            Height="50"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CheckoutCommand}"/>

                    <Button Content="Vaciar Carrito"
                            Classes="danger"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ClearCartCommand}"/>

                    <Border Background="{StaticResource PrimarySurfaceBrush}"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,8,0,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Classes="body"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
