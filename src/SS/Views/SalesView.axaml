<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS.ViewModels"
             x:Class="SS.Views.SalesView"
             x:DataType="vm:SalesViewModel">

    <Border Background="#FAF3F7" CornerRadius="8">
        <Grid ColumnDefinitions="*,350" Margin="15" RowDefinitions="Auto,*">
            <!-- Panel izquierdo: Carrito -->
            <StackPanel Grid.Column="0" Grid.Row="2" Spacing="10">
                <!-- Barra de busqueda por codigo -->
                <Border Background="#FFFFFF"
                        CornerRadius="6"
                        Padding="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Codigo de barras:"
                            FontSize="12"
                            Foreground="#6C3483"
                            VerticalAlignment="Center"/>
                        <TextBox Width="200"
                                 Height="30"
                                 FontSize="12"
                                 PlaceholderText="Escribir codigo..."
                                 Text="{Binding BarcodeInput, Mode=TwoWay}"
                                 VerticalContentAlignment="Center"/>
                        <Button Content="Agregar"
                                Background="#BB8FCE"
                                Foreground="White"
                                FontSize="12"
                                Command="{Binding AddByBarcodeCommand}"
                                Cursor="Hand"
                                VerticalContentAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11"
                                   Foreground="#4A148C"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Lista de productos disponibles -->
                <Border Background="#FFFFFF"
                        CornerRadius="6"
                        Padding="10"
                        Height="150">
                    <StackPanel>
                        <TextBlock Text="Productos disponibles"
                            FontSize="12"
                            Foreground="#6C3483"
                            FontWeight="Medium"
                            Margin="0,0,0,5"/>
                        <ListBox ItemsSource="{Binding AvailableProducts}"
                                 SelectedItem="{Binding SelectedProduct}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Width="150"/>
                                        <TextBlock Text="{Binding Barcode}"
                                                   FontSize="11"
                                                   Foreground="#6C3483"
                                                   VerticalAlignment="Center"
                                                   Width="130"/>
                                        <TextBlock Text="{Binding Price, StringFormat=${0:F2}}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#7B1FA2"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Boton agregar seleccionado -->
                <StackPanel HorizontalAlignment="Right">
                    <Button Content="Agregar Seleccionado"
                            Background="#BB8FCE"
                            Foreground="White"
                            FontSize="12"
                            Command="{Binding AddToCartCommand}"
                            Cursor="Hand"
                            Padding="15,8"/>
                </StackPanel>

                <!-- Carrito -->
                <Border Background="#FFFFFF"
                        CornerRadius="6"
                        Padding="10">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Carrito de Compras"
                            FontSize="14"
                            Foreground="#4A148C"
                            FontWeight="Medium"/>

                        <ListBox ItemsSource="{Binding CartItems}"
                                 Height="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                        <TextBlock Text="{Binding ProductName}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"
                                                   Width="150"/>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Spacing="5">
                                            <Button Content="-"
                                                    Width="25" Height="25"
                                                    FontSize="12"
                                                    Background="#E8DAEF"
                                                    Command="{Binding $parent[ListBox].((vm:SalesViewModel)DataContext).DecreaseQtyCommand}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"/>
                                            <TextBlock Text="{Binding Quantity}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Width="30"
                                                       HorizontalAlignment="Center"/>
                                            <Button Content="+"
                                                    Width="25" Height="25"
                                                    FontSize="12"
                                                    Background="#E8DAEF"
                                                    Command="{Binding $parent[ListBox].((vm:SalesViewModel)DataContext).IncreaseQtyCommand}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtotal, StringFormat=${0:F2}}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#7B1FA2"
                                                   VerticalAlignment="Center"
                                                   Width="80"/>
                                        <Button Content="X"
                                                    Width="25" Height="25"
                                                    FontSize="10"
                                                    Background="#EF5350"
                                                    Foreground="White"
                                                    Command="{Binding $parent[ListBox].((vm:SalesViewModel)DataContext).RemoveFromCartCommand}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Panel derecho: Resumen y cobro -->
            <Border Grid.Column="1"
                    Grid.Row="2"
                    Background="#FFFFFF"
                    CornerRadius="8"
                    Padding="20"
                    Margin="15,0,0,0"
                    VerticalAlignment="Top">
                <StackPanel Spacing="15">
                    <TextBlock Text="Resumen de Venta"
                        FontSize="16"
                        Foreground="#4A148C"
                        FontWeight="Bold"/>

                    <Border Height="1" Background="#E8DAEF"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Items:"
                                   FontSize="14"
                                   Foreground="#6C3483"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CartCount}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#7B1FA2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total:"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#4A148C"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CartTotal, StringFormat=${0:F2}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#7B1FA2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Height="1" Background="#E8DAEF"/>

                    <Button Content="COBRAR"
                            Background="#4A148C"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            Height="50"
                            Command="{Binding CheckoutCommand}"
                            Cursor="Hand"/>

                    <Button Content="Vaciar Carrito"
                            Background="#EF5350"
                            Foreground="White"
                            FontSize="12"
                            Height="35"
                            Command="{Binding ClearCartCommand}"
                            Cursor="Hand"/>

                    <Border Background="#E8DAEF" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11"
                                   Foreground="#4A148C"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
