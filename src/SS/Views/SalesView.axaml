<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS.ViewModels"
             xmlns:conv="using:SS.Converters"
             x:Class="SS.Views.SalesView"
             x:DataType="vm:SalesViewModel">

    <UserControl.Resources>
        <conv:BoolToStringConverter x:Key="CameraTextConverter"
                                     TrueValue="Cerrar Cámara"
                                     FalseValue="Iniciar Cámara"/>
        <conv:BoolToColorConverter x:Key="CameraColorConverter"
                                     TrueColor="#EF5350"
                                     FalseColor="#4CAF50"/>
        <conv:BoolToStringConverter x:Key="MobileTextConverter"
                                     TrueValue="Cerrar Móvil"
                                     FalseValue="Escanear Móvil"/>
        <conv:BoolToColorConverter x:Key="MobileColorConverter"
                                     TrueColor="#EF5350"
                                     FalseColor="#9C27B0"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="CaretBrush" Value="#4A148C"/>
            <Setter Property="BorderBrush" Value="#E8DAEF"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#BB8FCE"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#FAF3F7" CornerRadius="8">
        <Grid ColumnDefinitions="*,350" Margin="15" RowDefinitions="Auto,*">
            <!-- Panel izquierdo: Carrito -->
            <StackPanel Grid.Column="0" Grid.Row="2" Spacing="10">
                <!-- Cámara + Escáner -->
                <Border Background="#FFFFFF"
                        CornerRadius="6"
                        Padding="10">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Escáner de Cámara"
                                FontSize="13"
                                Foreground="#4A148C"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>
                            <Button Command="{Binding ToggleCameraCommand}"
                                    FontSize="11"
                                    Padding="12,6"
                                    CornerRadius="4"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Content="{Binding IsCameraActive, Converter={StaticResource CameraTextConverter}}"
                                    Background="{Binding IsCameraActive, Converter={StaticResource CameraColorConverter}}"/>
                        </StackPanel>

                        <!-- Feedback del escáner -->
                        <Border CornerRadius="4"
                                Padding="8,6"
                                Background="#F5F5F5"
                                IsVisible="{Binding ScanFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ScanFeedback}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding ScanFeedbackColor}"/>
                        </Border>

                        <!-- Vista previa de cámara con marco de escaneo -->
                        <Grid Height="200" IsVisible="{Binding IsCameraActive}">
                            <!-- Video de la cámara -->
                            <Image Source="{Binding CameraPreview}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                            <!-- Marco de escaneo (overlay) -->
                            <Border BorderBrush="#4CAF50"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Margin="30,30"
                                    Background="#11000000"/>

                            <!-- Esquinas destacadas del marco -->
                            <Canvas>
                                <Border Canvas.Left="30" Canvas.Top="30" Width="20" Height="20"
                                        BorderBrush="#4CAF50" BorderThickness="3,0,0,3" CornerRadius="4,0,0,0"/>
                                <Border Canvas.Right="30" Canvas.Top="30" Width="20" Height="20"
                                        BorderBrush="#4CAF50" BorderThickness="0,3,3,0" CornerRadius="0,4,0,0"/>
                                <Border Canvas.Left="30" Canvas.Bottom="30" Width="20" Height="20"
                                        BorderBrush="#4CAF50" BorderThickness="3,0,0,3" CornerRadius="0,0,0,4"/>
                                <Border Canvas.Right="30" Canvas.Bottom="30" Width="20" Height="20"
                                        BorderBrush="#4CAF50" BorderThickness="0,3,3,0" CornerRadius="0,0,4,0"/>
                            </Canvas>

                            <!-- Texto indicativo -->
                            <TextBlock Text="Coloque el código dentro del marco"
                                       FontSize="11"
                                       Foreground="White"
                                       Background="#AA000000"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,10"
                                       Padding="8,4"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Escáner Móvil -->
                <Border Background="#FFFFFF"
                        CornerRadius="6"
                        Padding="10">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Escáner Móvil"
                                FontSize="13"
                                Foreground="#4A148C"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>
                            <Button Command="{Binding ToggleMobileScannerCommand}"
                                    FontSize="11"
                                    Padding="12,6"
                                    CornerRadius="4"
                                    Foreground="White"
                                    Cursor="Hand"
                                    Content="{Binding IsMobileScannerActive, Converter={StaticResource MobileTextConverter}}"
                                    Background="{Binding IsMobileScannerActive, Converter={StaticResource MobileColorConverter}}"/>
                        </StackPanel>
                        <Border CornerRadius="4" Padding="6,4" Background="#F5F5F5"
                                IsVisible="{Binding MobileScanFeedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding MobileScanFeedback}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{Binding MobileScanFeedbackColor}"/>
                        </Border>
                        <Border Background="#F5F0FA" CornerRadius="4" Padding="8"
                                IsVisible="{Binding IsMobileScannerActive}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Image Source="{Binding MobileQrBitmap}" Width="70" Height="70" Stretch="Uniform"/>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Escanea desde tu teléfono" FontSize="10" Foreground="#6C3483"/>
                                    <TextBlock Text="Solo productos existentes" FontSize="9" Foreground="#BB8FCE"/>
                                    <TextBlock Text="{Binding MobileUrl}" FontSize="7" Foreground="#BB8FCE" TextWrapping="Wrap" MaxWidth="150"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Barra de búsqueda por código de barras -->
                <Border Background="#FFFFFF"
                        CornerRadius="6"
                        Padding="10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="O ingrese código manualmente:"
                            FontSize="12"
                            Foreground="#6C3483"
                            FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="200"
                                     Height="30"
                                     FontSize="12"
                                     PlaceholderText="Escribir o escanear..."
                                     Text="{Binding BarcodeInput, Mode=TwoWay}"
                                     VerticalContentAlignment="Center">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter"
                                                Command="{Binding AddByBarcodeCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Content="Buscar"
                                    Background="#BB8FCE"
                                    Foreground="White"
                                    FontSize="12"
                                    Padding="14,6"
                                    Command="{Binding AddByBarcodeCommand}"
                                    Cursor="Hand"
                                    VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11"
                                   Foreground="#4A148C"/>
                    </StackPanel>
                </Border>

                <!-- Carrito -->
                <Border Background="#FFFFFF"
                        CornerRadius="6"
                        Padding="10">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Carrito de Compras"
                            FontSize="14"
                            Foreground="#4A148C"
                            FontWeight="Medium"/>

                        <ListBox ItemsSource="{Binding CartItems}"
                                 Height="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                        <TextBlock Text="{Binding ProductName}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   VerticalAlignment="Center"
                                                   Width="150"/>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Spacing="5">
                                            <Button Content="-"
                                                    Width="25" Height="25"
                                                    FontSize="12"
                                                    Background="#E8DAEF"
                                                    Command="{Binding $parent[ListBox].((vm:SalesViewModel)DataContext).DecreaseQtyCommand}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"/>
                                            <TextBlock Text="{Binding Quantity}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Width="30"
                                                       HorizontalAlignment="Center"/>
                                            <Button Content="+"
                                                    Width="25" Height="25"
                                                    FontSize="12"
                                                    Background="#E8DAEF"
                                                    Command="{Binding $parent[ListBox].((vm:SalesViewModel)DataContext).IncreaseQtyCommand}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtotal, StringFormat=${0:F2}}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#7B1FA2"
                                                   VerticalAlignment="Center"
                                                   Width="80"/>
                                        <Button Content="X"
                                                    Width="25" Height="25"
                                                    FontSize="10"
                                                    Background="#EF5350"
                                                    Foreground="White"
                                                    Command="{Binding $parent[ListBox].((vm:SalesViewModel)DataContext).RemoveFromCartCommand}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Panel derecho: Resumen y cobro -->
            <Border Grid.Column="1"
                    Grid.Row="2"
                    Background="#FFFFFF"
                    CornerRadius="8"
                    Padding="20"
                    Margin="15,0,0,0"
                    VerticalAlignment="Top">
                <StackPanel Spacing="15">
                    <TextBlock Text="Resumen de Venta"
                        FontSize="16"
                        Foreground="#4A148C"
                        FontWeight="Bold"/>

                    <Border Height="1" Background="#E8DAEF"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Items:"
                                   FontSize="14"
                                   Foreground="#6C3483"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CartCount}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#7B1FA2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total:"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#4A148C"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CartTotal, StringFormat=${0:F2}}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#7B1FA2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Height="1" Background="#E8DAEF"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Método de pago:"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#4A148C"/>
                        <ComboBox ItemsSource="{Binding PaymentMethods}"
                                  SelectedItem="{Binding SelectedPaymentMethod}"
                                  FontSize="13"
                                  Padding="10,6"/>
                    </StackPanel>

                    <Button Content="COBRAR"
                            Background="#4A148C"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            Height="50"
                            Command="{Binding CheckoutCommand}"
                            Cursor="Hand"/>

                    <Button Content="Vaciar Carrito"
                            Background="#EF5350"
                            Foreground="White"
                            FontSize="12"
                            Height="35"
                            Command="{Binding ClearCartCommand}"
                            Cursor="Hand"/>

                    <Border Background="#E8DAEF" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11"
                                   Foreground="#4A148C"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

