<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SS.Views.RegisterWindow"
        Title="Safe-Sale - Crear cuenta"
        Icon="/Assets/SS-ico.png"
        Width="430" Height="690"
        MinWidth="400" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource PrimaryHoverBrush}"
        KeyDown="Window_KeyDown">

    <Panel>
        <Border Background="{StaticResource PrimaryMediumBrush}" Opacity="0.08"
                CornerRadius="200" Width="400" Height="400"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="-100,-100,0,0"/>
        <Border Background="{StaticResource PrimaryMediumBrush}" Opacity="0.05"
                CornerRadius="200" Width="300" Height="300"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="0,0,-80,-80"/>

        <Border CornerRadius="20"
                Background="{StaticResource BackgroundCardBrush}"
                Margin="24"
                Padding="32,24"
                BoxShadow="0 8 32 0 #22000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
            <StackPanel Spacing="0">

                <Border Background="{StaticResource PrimaryMediumBrush}" CornerRadius="14"
                        Width="56" Height="56"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                    <TextBlock Text="SS" FontSize="20" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Crear cuenta"
                           FontSize="21" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Registrá un nuevo usuario del sistema"
                           Classes="page-subtitle"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,22"/>

                <!-- Usuario -->
                <StackPanel Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="USUARIO" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" LetterSpacing="1"/>
                    <TextBox Name="UsernameBox"
                             PlaceholderText="Ej: juan.perez"
                             FontSize="14" Padding="12,10" CornerRadius="10"
                             BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1.5"
                             Background="{StaticResource PrimaryBackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Name="UsernameError" IsVisible="False"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>

                <!-- Contraseña -->
                <StackPanel Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="CONTRASEÑA" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" LetterSpacing="1"/>
                    <TextBox Name="PasswordBox"
                             PasswordChar="*"
                             PlaceholderText="Mínimo 6 caracteres"
                             FontSize="14" Padding="12,10" CornerRadius="10"
                             BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1.5"
                             Background="{StaticResource PrimaryBackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Name="PasswordError" IsVisible="False"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>

                <!-- Confirmar contraseña -->
                <StackPanel Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="CONFIRMAR CONTRASEÑA" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" LetterSpacing="1"/>
                    <TextBox Name="ConfirmBox"
                             PasswordChar="*"
                             PlaceholderText="Repetí la contraseña"
                             FontSize="14" Padding="12,10" CornerRadius="10"
                             BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1.5"
                             Background="{StaticResource PrimaryBackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Name="ConfirmError" IsVisible="False"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>

                <!-- Rol -->
                <Border Background="{StaticResource PrimarySurfaceLightBrush}"
                        CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="ROL" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" LetterSpacing="1"/>
                        <TextBlock Text="Se creará como usuario Cajero."
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryMediumBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Error general -->
                <Border Name="ErrorBorder" IsVisible="False"
                        Background="#22EF5350" CornerRadius="8" Padding="12,10"
                        Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="&#x26A0;" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Name="ErrorText"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,10,*" Margin="0,2,0,0">
                    <Button Name="CancelButton" Grid.Column="0"
                            Content="Cancelar"
                            Classes="secondary"
                            FontSize="13" Padding="0,12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Name="RegisterButton" Grid.Column="2"
                            Content="Registrarse"
                            Classes="primary"
                            FontSize="13" Padding="0,12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                </Grid>

            </StackPanel>
        </Border>
    </Panel>
</Window>
