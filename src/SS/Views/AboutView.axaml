<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS.ViewModels"
             x:Class="SS.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <Border Background="#FAF3F7" CornerRadius="8" Margin="10">
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="20" HorizontalAlignment="Center" MaxWidth="500">

                <!-- Logo -->
                <Border Background="#7B1FA2" CornerRadius="20"
                        Width="80" Height="80"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                    <TextBlock Text="SS"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- App Info -->
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AppName}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#4A148C"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion}"
                               FontSize="14"
                               Foreground="#7B1FA2"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="12"
                               Foreground="#9C8EBF"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Height="1" Background="#E8DAEF"/>

                <!-- Features -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="18"
                        BoxShadow="0 2 8 0 #11000000">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Características"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#4A148C"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="• Punto de venta con carrito de compras" FontSize="12" Foreground="#6C3483"/>
                            <TextBlock Text="• Gestión de inventario con código de barras" FontSize="12" Foreground="#6C3483"/>
                            <TextBlock Text="• Escáner de cámara PC y móvil" FontSize="12" Foreground="#6C3483"/>
                            <TextBlock Text="• Dashboard con estadísticas en tiempo real" FontSize="12" Foreground="#6C3483"/>
                            <TextBlock Text="• Historial de ventas y registros" FontSize="12" Foreground="#6C3483"/>
                            <TextBlock Text="• Actualizaciones automáticas" FontSize="12" Foreground="#6C3483"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Update Section -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="18"
                        BoxShadow="0 2 8 0 #11000000">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔄"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Actualizaciones"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#4A148C"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" Background="#F0EAF5"/>

                        <Border CornerRadius="8"
                                Padding="12,8"
                                Background="#F5F0FA"
                                IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding UpdateStatus}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding UpdateStatusColor}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Button Command="{Binding CheckForUpdatesCommand}"
                                IsEnabled="{Binding !IsChecking}"
                                Background="#7B1FA2"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="0,12"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="Buscar Actualizaciones"
                                           VerticalAlignment="Center"/>
                                <ProgressBar IsVisible="{Binding IsChecking}"
                                             Width="16" Height="16"
                                             IsIndeterminate="True"
                                             Foreground="White"
                                             Background="Transparent"
                                             VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Credits -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="18"
                        BoxShadow="0 2 8 0 #11000000">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Equipo de Desarrollo"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#4A148C"/>
                        <Border Height="1" Background="#F0EAF5"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Lucas — Backend" FontSize="12" Foreground="#6C3483"/>
                            <TextBlock Text="Jandir — Frontend" FontSize="12" Foreground="#6C3483"/>
                            <TextBlock Text="Dante — Documentación" FontSize="12" Foreground="#6C3483"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="© 2026 Safe-Sale. Todos los derechos reservados."
                           FontSize="10"
                           Foreground="#BBB0CB"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,20"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
