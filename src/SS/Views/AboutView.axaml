<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS.ViewModels"
             x:Class="SS.Views.AboutView"
             x:DataType="vm:AboutViewModel">

    <Border Background="{StaticResource BackgroundAppBrush}" CornerRadius="8">
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="20" HorizontalAlignment="Center" MaxWidth="500">

                <!-- Logo -->
                <Border Background="{StaticResource PrimaryMediumBrush}"
                        CornerRadius="20"
                        Width="80" Height="80"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">
                    <TextBlock Text="SS"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- App Info -->
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AppName}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion}"
                               FontSize="14"
                               Foreground="{StaticResource PrimaryMediumBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Description}"
                               Classes="page-subtitle"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Classes="separator"/>

                <!-- Features -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Características" Classes="section-title"/>
                        <StackPanel Spacing="8">
                            <TextBlock Text="• Punto de venta con carrito de compras" Classes="body"/>
                            <TextBlock Text="• Gestión de inventario con código de barras" Classes="body"/>
                            <TextBlock Text="• Escáner de cámara PC y móvil" Classes="body"/>
                            <TextBlock Text="• Dashboard con estadísticas en tiempo real" Classes="body"/>
                            <TextBlock Text="• Historial de ventas y registros" Classes="body"/>
                            <TextBlock Text="• Actualizaciones automáticas" Classes="body"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Update Section -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔄" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Actualizaciones" Classes="section-title" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Classes="separator"/>

                        <Border CornerRadius="8"
                                Padding="14,10"
                                Background="{StaticResource PrimarySurfaceLightBrush}"
                                IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding UpdateStatus}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding UpdateStatusColor}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <Button Command="{Binding CheckForUpdatesCommand}"
                                Classes="primary"
                                IsEnabled="{Binding !IsChecking}"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="Buscar Actualizaciones" VerticalAlignment="Center"/>
                                <ProgressBar IsVisible="{Binding IsChecking}"
                                             Width="16" Height="16"
                                             IsIndeterminate="True"
                                             Foreground="White"
                                             Background="Transparent"
                                             VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Credits -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Equipo de Desarrollo" Classes="section-title"/>
                        <Border Classes="separator"/>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Lucas — Backend" Classes="body"/>
                            <TextBlock Text="Jandir — Frontend" Classes="body"/>
                            <TextBlock Text="Dante — Documentación" Classes="body"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="© 2026 Safe-Sale. Todos los derechos reservados."
                           Classes="caption"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,20"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
