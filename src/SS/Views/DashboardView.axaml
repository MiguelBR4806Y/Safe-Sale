<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SS.ViewModels"
             x:Class="SS.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.card-icon">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Opacity" Value="0.3"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#FAF3F7" CornerRadius="8">
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="20">

                <!-- Header -->
                <StackPanel Spacing="2">
                    <TextBlock Text="DASHBOARD"
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="#4A148C"/>
                    <TextBlock Text="Resumen general del sistema"
                        FontSize="12"
                        Foreground="#9C8EBF"/>
                </StackPanel>

                <!-- KPI Cards -->
                <UniformGrid Columns="2" Rows="2" Margin="0,5">
                    <!-- Ventas Hoy -->
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="4"
                            BoxShadow="0 2 8 0 #11000000">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="VENTAS HOY"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="#9C8EBF"
                                    LetterSpacing="1"/>
                                <TextBlock Text="{Binding TodaySales, StringFormat=${0}}"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Foreground="#4A148C"/>
                                <TextBlock Text="ingresos del día"
                                    FontSize="10"
                                    Foreground="#BBB0CB"/>
                            </StackPanel>
                            <TextBlock Text="&#x1F4B0;" Classes="card-icon"/>
                        </Grid>
                    </Border>

                    <!-- Ingresos Mes -->
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="4"
                            BoxShadow="0 2 8 0 #11000000">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="INGRESOS MES"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="#9C8EBF"
                                    LetterSpacing="1"/>
                                <TextBlock Text="{Binding MonthIncome, StringFormat=${0}}"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Foreground="#7B1FA2"/>
                                <TextBlock Text="acumulado mensual"
                                    FontSize="10"
                                    Foreground="#BBB0CB"/>
                            </StackPanel>
                            <TextBlock Text="&#x1F4C8;" Classes="card-icon"/>
                        </Grid>
                    </Border>

                    <!-- Productos Activos -->
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="4"
                            BoxShadow="0 2 8 0 #11000000">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="PRODUCTOS"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="#9C8EBF"
                                    LetterSpacing="1"/>
                                <TextBlock Text="{Binding ActiveProducts}"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Foreground="#4CAF50"/>
                                <TextBlock Text="productos activos"
                                    FontSize="10"
                                    Foreground="#BBB0CB"/>
                            </StackPanel>
                            <TextBlock Text="&#x1F4E6;" Classes="card-icon"/>
                        </Grid>
                    </Border>

                    <!-- Total Ventas -->
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="18" Margin="4"
                            BoxShadow="0 2 8 0 #11000000">
                        <Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="TRANSACCIONES"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="#9C8EBF"
                                    LetterSpacing="1"/>
                                <TextBlock Text="{Binding TodayCustomers}"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Foreground="#FF9800"/>
                                <TextBlock Text="ventas realizadas"
                                    FontSize="10"
                                    Foreground="#BBB0CB"/>
                            </StackPanel>
                            <TextBlock Text="&#x1F4CB;" Classes="card-icon"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Últimas ventas -->
                <Border Background="#FFFFFF" CornerRadius="10" Padding="18"
                        BoxShadow="0 2 8 0 #11000000">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#x1F4C5;"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Últimas Ventas"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="#4A148C"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" Background="#F0EAF5"/>

                        <ListBox ItemsSource="{Binding RecentSales}"
                                 Height="220"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6"
                                            Background="#FBF8FE"
                                            CornerRadius="6"
                                            Margin="0,1">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0"
                                                    Background="#E8DAEF"
                                                    CornerRadius="6"
                                                    Width="36" Height="36"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="&#x1F4B3;"
                                                           FontSize="16"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Id, StringFormat='Venta #{0}'}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#4A148C"/>
                                                <TextBlock Text="{Binding CreatedAt}"
                                                           FontSize="10"
                                                           Foreground="#9C8EBF"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Total, StringFormat=${0:F2}}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#7B1FA2"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
