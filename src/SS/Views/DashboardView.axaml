<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SS.Views.DashboardView">

    <Border Background="#FAF3F7" CornerRadius="8">
        <StackPanel Margin="20" Spacing="20">
            
            <TextBlock Text="DASHBOARD"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#4A148C"
                HorizontalAlignment="Center"/>
            
            <!-- KPI Cards -->
            <UniformGrid Columns="2" Rows="2" Margin="0,15">
                <!-- Tarjeta Ventas Día -->
                <Border Background="#E8DAEF" CornerRadius="6" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Ventas Día"
                            FontSize="12"
                            Foreground="#6C348C"
                            Margin="0,0,0,5"/>
                        <TextBlock Text="$1,247.50"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#7B1FA2"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta Ingresos Mes -->
                <Border Background="#E8DAEF" CornerRadius="6" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Ingresos Mes"
                            FontSize="12"
                            Foreground="#6C348C"/>
                        <TextBlock Text="$12,475.00"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#7B1FA2"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta Productos -->
                <Border Background="#E8DAEF" CornerRadius="6" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Productos Activos"
                            FontSize="12"
                            Foreground="#6C348C"/>
                        <TextBlock Text="1,247"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#7B1FA2"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta Clientes -->
                <Border Background="#E8DAEF" CornerRadius="6" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Clientes Hoy"
                            FontSize="12"
                            Foreground="#6C348C"/>
                        <TextBlock Text="241"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#7B1FA2"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Gráfico de ventas por hora (placeholder) -->
            <Border Background="#FFFFFF" CornerRadius="8" Height="200">
                <TextBlock Text="Gráfico de Ventas\n(Por Hora)"
                    FontSize="16"
                    Foreground="#6C348C"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>

            <!-- Últimas ventas -->
            <Border Background="#FFFFFF" CornerRadius="8" Height="150">
                <TextBlock Text="Últimas Ventas"
                    FontSize="14"
                    Foreground="#6C348C"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>