<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SS.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="SS.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Safe-Sale"
        Width="1200" Height="700"
        MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Sidebar -->
        <Border DockPanel.Dock="Left"
                Width="220"
                Background="#4A148C">
            <StackPanel Spacing="0">
                <!-- Logo -->
                <Border Background="#3A0D6E" Padding="20,25">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="SS"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#E8DAEF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Safe-Sale"
                                   FontSize="11"
                                   Foreground="#BB8FCE"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Separador -->
                <Border Height="1" Background="#5C2D91" Margin="15,0"/>

                <!-- Navegación -->
                <StackPanel Spacing="2" Margin="10,15">
                    <Button Command="{Binding NavigateDashboardCommand}"
                            Background="Transparent"
                            Foreground="#E8DAEF"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="15,12"
                            FontSize="14"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateInventoryCommand}"
                            Background="Transparent"
                            Foreground="#E8DAEF"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="15,12"
                            FontSize="14"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📦" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Inventario" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateSalesCommand}"
                            Background="Transparent"
                            Foreground="#E8DAEF"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="15,12"
                            FontSize="14"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🛒" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Ventas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateRecordsCommand}"
                            Background="Transparent"
                            Foreground="#E8DAEF"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="15,12"
                            FontSize="14"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Registros" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Espacio flexible -->
                <StackPanel Spacing="0" VerticalAlignment="Bottom" Margin="0,0,0,15">
                    <Border Height="1" Background="#5C2D91" Margin="15,0"/>

                    <!-- Usuario logueado -->
                    <Border Background="#3A0D6E" CornerRadius="8" Padding="12,10" Margin="10,12,10,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding CurrentUsername}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#E8DAEF"/>
                            <TextBlock Text="{Binding CurrentRole}"
                                       FontSize="11"
                                       Foreground="#BB8FCE"/>
                        </StackPanel>
                    </Border>

                    <!-- Botón cerrar sesión -->
                    <Button Command="{Binding LogoutCommand}"
                            Background="Transparent"
                            Foreground="#BB8FCE"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            Padding="10,10"
                            FontSize="12"
                            Cursor="Hand"
                            Margin="10,6,10,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🚪" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="Cerrar Sesión" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="v1.0.0"
                               FontSize="10"
                               Foreground="#7B1FA2"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Contenido principal -->
        <DockPanel Background="#FAF3F7">
            <!-- Barra superior -->
            <Border DockPanel.Dock="Top"
                    Background="#FFFFFF"
                    Padding="20,12"
                    BorderBrush="#E8DAEF"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding CurrentViewTitle}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#4A148C"/>
            </Border>

            <!-- Vista actual -->
            <ContentControl Content="{Binding CurrentViewModel}"
                            Margin="15"/>
        </DockPanel>
    </DockPanel>
</Window>
