<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SS.Dialogs.QuickAddProductDialog"
        Title="Agregar Producto Rápido"
        Width="380" Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#FAF3F7">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E8DAEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#212121"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#7B1FA2"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#BB8FCE"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="12"
            Background="#FFFFFF"
            Margin="16"
            Padding="24"
            BorderBrush="#E8DAEF"
            BorderThickness="1">
        <StackPanel Spacing="12">
            <TextBlock Text="Nuevo Producto"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#4A148C"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Código de barras:"
                       FontSize="12"
                       Foreground="#6C3483"
                       FontWeight="SemiBold"/>
            <TextBox Name="BarcodeBox"/>

            <TextBlock Text="Nombre del producto:"
                       FontSize="12"
                       Foreground="#6C3483"
                       FontWeight="SemiBold"/>
            <TextBox Name="NameBox"/>

            <TextBlock Text="Precio:"
                       FontSize="12"
                       Foreground="#6C3483"
                       FontWeight="SemiBold"/>
            <TextBox Name="PriceBox"/>

            <Border Name="ErrorBorder"
                    IsVisible="False"
                    Background="#22EF5350"
                    CornerRadius="6"
                    Padding="10,8">
                <TextBlock Name="ErrorText"
                           Foreground="#EF5350"
                           FontSize="12"
                           FontWeight="SemiBold"/>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,8,0,0">
                <Button Name="CancelButton"
                        Content="Cancelar"
                        Background="#EF5350"
                        Foreground="White"
                        FontSize="12"
                        Padding="16,8"
                        CornerRadius="6"
                        Cursor="Hand"/>
                <Button Name="SaveButton"
                        Content="Guardar"
                        Background="#4A148C"
                        Foreground="White"
                        FontSize="12"
                        Padding="16,8"
                        CornerRadius="6"
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

