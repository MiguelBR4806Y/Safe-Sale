<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SS.Dialogs.QuickAddProductDialog"
        Title="Agregar Producto Rápido"
        Width="400" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#FAF3F7">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E8DAEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="CaretBrush" Value="#4A148C"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#7B1FA2"/>
        </Style>
        <Style Selector="TextBox:error">
            <Setter Property="BorderBrush" Value="#EF5350"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#7B1FA2"/>
        </Style>
        <Style Selector="TextBox:error /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#EF5350"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#BB8FCE"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="12"
            Background="#FFFFFF"
            Margin="16"
            Padding="24"
            BorderBrush="#E8DAEF"
            BorderThickness="1">
        <StackPanel Spacing="10">
            <TextBlock Text="Nuevo Producto"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#4A148C"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <!-- Barcode -->
            <TextBlock Text="Código de barras:"
                       FontSize="12"
                       Foreground="#6C3483"
                       FontWeight="SemiBold"/>
            <TextBox Name="BarcodeBox"
                     PlaceholderText="Opcional: Ej. 1234567890123"
                     MaxLength="13"/>
            <TextBlock Name="BarcodeHelp"
                       Text="Opcional. Solo números, max 13 dígitos"
                       FontSize="10"
                       Foreground="#6C3483"
                       Margin="0,2,0,0"/>
            <TextBlock Name="BarcodeError"
                       FontSize="11"
                       Foreground="#EF5350"
                       FontWeight="SemiBold"
                       IsVisible="False"
                       Margin="0,2,0,0"/>

            <!-- Name -->
            <TextBlock Text="Nombre del producto:"
                       FontSize="12"
                       Foreground="#6C3483"
                       FontWeight="SemiBold"/>
            <TextBox Name="NameBox"
                     PlaceholderText="Mínimo 3 caracteres"/>
            <TextBlock Name="NameError"
                       FontSize="11"
                       Foreground="#EF5350"
                       FontWeight="SemiBold"
                       IsVisible="False"
                       Margin="0,2,0,0"/>

            <!-- Price -->
            <TextBlock Text="Precio:"
                       FontSize="12"
                       Foreground="#6C3483"
                       FontWeight="SemiBold"/>
            <TextBox Name="PriceBox"
                     PlaceholderText="Ej: 10.50"/>
            <TextBlock Name="PriceError"
                       FontSize="11"
                       Foreground="#EF5350"
                       FontWeight="SemiBold"
                       IsVisible="False"
                       Margin="0,2,0,0"/>

            <!-- Error general (para errores de BD) -->
            <Border Name="ErrorBorder"
                    IsVisible="False"
                    Background="#22EF5350"
                    CornerRadius="6"
                    Padding="10,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Name="ErrorText"
                               Foreground="#EF5350"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="\u2716"
                               Foreground="#EF5350"
                               FontSize="12"
                               Cursor="Hand"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,4,0,0">
                <Button Name="CancelButton"
                        Content="Cancelar"
                        Background="#EF5350"
                        Foreground="White"
                        FontSize="12"
                        Padding="16,8"
                        CornerRadius="6"
                        Cursor="Hand"/>
                <Button Name="SaveButton"
                        Content="Guardar"
                        Background="#4A148C"
                        Foreground="White"
                        FontSize="12"
                        Padding="16,8"
                        CornerRadius="6"
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
