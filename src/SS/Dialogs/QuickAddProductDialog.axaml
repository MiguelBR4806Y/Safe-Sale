<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SS.Dialogs.QuickAddProductDialog"
        Title="Agregar Producto Rápido"
        Width="380" Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#FAF3F7">

    <Border CornerRadius="12"
            Background="#FFFFFF"
            Margin="16"
            Padding="24"
            BorderBrush="#E8DAEF"
            BorderThickness="1">
        <StackPanel Spacing="12">
            <TextBlock Text="Nuevo Producto"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#4A148C"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Código de barras:"
                       FontSize="12"
                       Foreground="#6C3483"
                       FontWeight="SemiBold"/>
            <TextBox Name="BarcodeBox"
                     FontSize="13"
                     Padding="10,8"
                     CornerRadius="6"
                     BorderBrush="#E8DAEF"
                     BorderThickness="1"
                     Background="#FFFFFF"
                     Foreground="#212121"
                     IsReadOnly="True"/>

            <TextBlock Text="Nombre del producto:"
                       FontSize="12"
                       Foreground="#6C3483"
                       FontWeight="SemiBold"/>
            <TextBox Name="NameBox"
                     FontSize="13"
                     Padding="10,8"
                     CornerRadius="6"
                     BorderBrush="#E8DAEF"
                     BorderThickness="1"
                     Background="#FFFFFF"
                     Foreground="#212121"/>

            <TextBlock Text="Precio:"
                       FontSize="12"
                       Foreground="#6C3483"
                       FontWeight="SemiBold"/>
            <TextBox Name="PriceBox"
                     FontSize="13"
                     Padding="10,8"
                     CornerRadius="6"
                     BorderBrush="#E8DAEF"
                     BorderThickness="1"
                     Background="#FFFFFF"
                     Foreground="#212121"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,8,0,0">
                <Button Name="CancelButton"
                        Content="Cancelar"
                        Background="#EF5350"
                        Foreground="White"
                        FontSize="12"
                        Padding="16,8"
                        CornerRadius="6"
                        Cursor="Hand"/>
                <Button Name="SaveButton"
                        Content="Guardar"
                        Background="#4A148C"
                        Foreground="White"
                        FontSize="12"
                        Padding="16,8"
                        CornerRadius="6"
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
